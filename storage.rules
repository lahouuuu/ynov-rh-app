rules_version = '2';

// Les justificatifs sont privés : aucun accès direct depuis le navigateur.
// Le dépôt et le téléchargement passent par l'API, qui vérifie le rôle et le
// périmètre avant chaque opération. Aucun lien public n'est généré.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
