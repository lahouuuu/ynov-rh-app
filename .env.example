# Copier ce fichier en .env.production.local (non versionné) puis renseigner les valeurs.
# Il est lu par `npm run build` / `npm run deploy`.
# Configuration web Firebase : Console Firebase > Paramètres du projet > Vos applications.
# Ces identifiants ne sont pas des secrets, mais ils restent hors du dépôt.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ynov-rh-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ynov-rh-app
NEXT_PUBLIC_FIREBASE_APP_ID=

# URL de l'API. En production (Firebase Hosting), laisser /api.
# En développement avec `npm run dev` et les émulateurs :
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:5001/demo-ynov-rh/europe-west1/api
NEXT_PUBLIC_API_URL=/api

# true pour utiliser l'émulateur d'authentification (développement local uniquement)
NEXT_PUBLIC_UTILISER_EMULATEURS=false
