rules_version = '2';

// Toutes les lectures et écritures passent par l'API (Cloud Functions), qui
// utilise le SDK Admin et applique elle-même les contrôles d'identité, de rôle
// et de périmètre. Le SDK Admin n'est pas soumis à ces règles : l'accès direct
// depuis le navigateur est donc entièrement fermé, ce qui empêche tout
// contournement de l'API (lecture de dossiers d'autrui, modification de solde…).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
